# Reference only: run python scripts/configure.py --docker to generate secrets.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
NEWS_DB_ENGINE=mariadb
DB_NAME=news_app
DB_USER=news_user
DB_PASSWORD=replace-with-your-password
DB_HOST=127.0.0.1
DB_PORT=3306
MARIADB_ROOT_PASSWORD=replace-with-a-different-password
API_BASE_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
